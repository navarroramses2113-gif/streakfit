# Netlify publishes every file in this repo, but the site only needs the
# app. The server's code and SQL stay off it: they hold no secrets, this
# just keeps how the server works to ourselves. "404!" answers "not found"
# even though the file exists.
#
# The app DOES load two files from supabase/functions/_shared/
# (game-rules.js and exercise-counter.js), so that folder is closed file by
# file instead of all at once. A new Edge Function folder or a new file in
# _shared needs a line here; new SQL goes in supabase/sql/ and is covered.

/supabase/sql/*                            /404.html  404!
/supabase/config.toml                      /404.html  404!
/supabase/.gitignore                       /404.html  404!

/supabase/functions/challenge/*            /404.html  404!
/supabase/functions/challenge-tick/*       /404.html  404!
/supabase/functions/delete-account/*       /404.html  404!
/supabase/functions/invite/*               /404.html  404!
/supabase/functions/log-activity/*         /404.html  404!
/supabase/functions/log-day/*              /404.html  404!
/supabase/functions/notify-friend-request/* /404.html  404!
/supabase/functions/nudge/*                /404.html  404!
/supabase/functions/plan/*                 /404.html  404!
/supabase/functions/send-reminders/*       /404.html  404!
/supabase/functions/submit-set/*           /404.html  404!
/supabase/functions/waitlist/*             /404.html  404!
/supabase/functions/weekly-recap/*         /404.html  404!

/supabase/functions/_shared/challenges.ts  /404.html  404!
/supabase/functions/_shared/http.ts        /404.html  404!
/supabase/functions/_shared/invite.ts      /404.html  404!
/supabase/functions/_shared/nudge.ts       /404.html  404!
/supabase/functions/_shared/pet-voice.ts   /404.html  404!
/supabase/functions/_shared/plan.ts        /404.html  404!
/supabase/functions/_shared/push.ts        /404.html  404!
/supabase/functions/_shared/waitlist.ts    /404.html  404!
/supabase/functions/_shared/weekly.ts      /404.html  404!

# The front page. getforja.app/ shows landing.html; the app stays at
# /index.html (the Home Screen app opens that, see manifest.json). An invite
# link (/?i=<code>) belongs to the app, so a shared link previews the app's
# card. "200!" serves the other file without changing the address, even
# though index.html exists. landing.html also sends app users on (its first
# script).
/  i=:code  /index.html  200!
/           /landing.html  200!

# getforja.app/install: the Home Screen steps as a page to send (install.html).
/install    /install.html  200
